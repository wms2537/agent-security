{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invalid.example/orf-heldout-v5-artifacts.schema.json",
  "title": "ORF-B v5 custody, outcome, and valid-summary artifacts",
  "$comment": "JSON shape is enforced here. Cross-artifact and arithmetic predicates V01-V24 are mandatory in orf-heldout-v5.json and are not delegated to JSON Schema.",
  "oneOf": [
    {"$ref": "#/$defs/nistPulseEnvelope"},
    {"$ref": "#/$defs/freezeStarted"},
    {"$ref": "#/$defs/freeze"},
    {"$ref": "#/$defs/publication"},
    {"$ref": "#/$defs/targetFetchStarted"},
    {"$ref": "#/$defs/opened"},
    {"$ref": "#/$defs/evaluationStarted"},
    {"$ref": "#/$defs/validSummary"},
    {"$ref": "#/$defs/outcome"},
    {"$ref": "#/$defs/completed"},
    {"$ref": "#/$defs/terminalPublication"}
  ],
  "$defs": {
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex128Upper": {"type": "string", "pattern": "^[0-9A-F]{128}$"},
    "nullableHex64": {"oneOf": [{"$ref": "#/$defs/hex64"}, {"type": "null"}]},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "fixed12": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{12}$"},
    "rationalMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "percent_fixed_12"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1},
        "percent_fixed_12": {"$ref": "#/$defs/fixed12"}
      }
    },
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comp/sdk/aicomp_sdk/scoring.py",
        "comp/sdk/aicomp_sdk/core/predicates.py",
        "comp/sdk/aicomp_sdk/evaluation/ops.py",
        "comp/sdk/kaggle_evaluation/jed_attack_134815/jed_attack_gateway.py",
        "experiments/attack.py"
      ],
      "properties": {
        "comp/sdk/aicomp_sdk/scoring.py": {"$ref": "#/$defs/hex64"},
        "comp/sdk/aicomp_sdk/core/predicates.py": {"$ref": "#/$defs/hex64"},
        "comp/sdk/aicomp_sdk/evaluation/ops.py": {"$ref": "#/$defs/hex64"},
        "comp/sdk/kaggle_evaluation/jed_attack_134815/jed_attack_gateway.py": {"$ref": "#/$defs/hex64"},
        "experiments/attack.py": {"$ref": "#/$defs/hex64"}
      }
    },
    "freezeStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "implementation_commit", "contract_sha256", "artifact_schema_sha256", "created_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-freeze-started-v1"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "created_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "implementation_commit", "contract_sha256", "artifact_schema_sha256", "evaluator_sha256", "prediction_ledger_sha256", "source_hashes_sha256", "freeze_started_sha256", "anchor_raw_sha256", "anchor_uri", "anchor_timestamp_iso", "anchor_unix_ms", "target_unix_ms", "created_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-freeze-v3"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "evaluator_sha256": {"$ref": "#/$defs/hex64"},
        "prediction_ledger_sha256": {"$ref": "#/$defs/hex64"},
        "source_hashes_sha256": {"$ref": "#/$defs/sourceHashes"},
        "freeze_started_sha256": {"$ref": "#/$defs/hex64"},
        "anchor_raw_sha256": {"$ref": "#/$defs/hex64"},
        "anchor_uri": {"const": "https://beacon.nist.gov/beacon/2.0/pulse/last"},
        "anchor_timestamp_iso": {"$ref": "#/$defs/utc"},
        "anchor_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "created_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "freeze_commit", "freeze_json_sha256", "target_unix_ms", "publication_message", "user_acknowledgment", "ack_received_at_utc", "user_ack_file_sha256"],
      "properties": {
        "schema_version": {"const": "orf-publication-v3"},
        "freeze_commit": {"$ref": "#/$defs/hex40"},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "publication_message": {"type": "string", "pattern": "^ORF-B FREEZE FREEZE_COMMIT=[0-9a-f]{40} FREEZE_JSON_SHA256=[0-9a-f]{64} TARGET_UNIX_MS=[0-9]+$"},
        "user_acknowledgment": {"type": "string", "pattern": "^ACK ORF-B FREEZE FREEZE_COMMIT=[0-9a-f]{40} FREEZE_JSON_SHA256=[0-9a-f]{64} TARGET_UNIX_MS=[0-9]+$"},
        "ack_received_at_utc": {"$ref": "#/$defs/utc"},
        "user_ack_file_sha256": {"$ref": "#/$defs/hex64"}
      }
    },
    "targetFetchStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "acknowledgment_commit", "freeze_json_sha256", "target_unix_ms", "target_uri", "created_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-target-fetch-started-v1"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "target_uri": {"type": "string", "pattern": "^https://beacon\\.nist\\.gov/beacon/2\\.0/pulse/time/[0-9]+$"},
        "created_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "opened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "implementation_commit", "freeze_commit", "acknowledgment_commit", "contract_sha256", "artifact_schema_sha256", "freeze_json_sha256", "publication_json_sha256", "target_fetch_started_sha256", "target_unix_ms", "pulse_raw_sha256", "pulse_uri", "pulse_timestamp_iso", "pulse_unix_ms", "pulse_output_value", "master_digest_hex", "opened_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-opened-v3"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "freeze_commit": {"$ref": "#/$defs/hex40"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "publication_json_sha256": {"$ref": "#/$defs/hex64"},
        "target_fetch_started_sha256": {"$ref": "#/$defs/hex64"},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "pulse_raw_sha256": {"$ref": "#/$defs/hex64"},
        "pulse_uri": {"type": "string", "pattern": "^https://beacon\\.nist\\.gov/"},
        "pulse_timestamp_iso": {"$ref": "#/$defs/utc"},
        "pulse_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "pulse_output_value": {"$ref": "#/$defs/hex128Upper"},
        "master_digest_hex": {"$ref": "#/$defs/hex64"},
        "opened_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "evaluationStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "acknowledgment_commit", "contract_sha256", "opened_json_sha256", "started_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-evaluation-started-v3"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "opened_json_sha256": {"$ref": "#/$defs/hex64"},
        "started_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "stratumMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum_index", "adaptive_objective", "global_objective", "regret", "positive_regret_profiles", "gain"],
      "properties": {
        "stratum_index": {"type": "integer", "minimum": 0, "maximum": 39},
        "adaptive_objective": {"type": "integer", "minimum": 0},
        "global_objective": {"type": "integer", "minimum": 0},
        "regret": {"type": "integer", "minimum": 0},
        "positive_regret_profiles": {"type": "integer", "minimum": 0, "maximum": 8},
        "gain": {"$ref": "#/$defs/rationalMetric"}
      }
    },
    "histogramBin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_inclusive", "upper_exclusive", "count"],
      "properties": {
        "lower_inclusive": {"type": "integer", "minimum": 0},
        "upper_exclusive": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "count": {"type": "integer", "minimum": 0, "maximum": 320}
      }
    },
    "failureCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NONE", "BEACON_FETCH", "BEACON_SCHEMA", "BEACON_TIMESTAMP", "FREEZE_EXISTS", "FREEZE_SCHEMA", "PUBLICATION_SCHEMA", "ACK_LATE", "GIT_DIRTY", "GIT_HEAD_MISMATCH", "GIT_DIFF_MISMATCH", "HASH_MISMATCH", "PREDICTION_LEDGER", "PROFILE_SCHEMA", "PREDICATE_ASSERTION", "SCORE_ASSERTION", "POLICY_EXCEPTION", "ROW_COUNT", "DUPLICATE_ROW", "OUTPUT_SCHEMA", "FREEZE_STARTED_CREATE", "TARGET_FETCH_STARTED_CREATE", "OPENED_CREATE", "EVALUATION_STARTED_CREATE", "EVALUATION_CRASH", "NUMERIC_STABILITY", "COMPLETED_CREATE", "UNEXPECTED_EXCEPTION"],
      "properties": {
        "NONE": {"type": "integer", "minimum": 0},
        "BEACON_FETCH": {"type": "integer", "minimum": 0},
        "BEACON_SCHEMA": {"type": "integer", "minimum": 0},
        "BEACON_TIMESTAMP": {"type": "integer", "minimum": 0},
        "FREEZE_EXISTS": {"type": "integer", "minimum": 0},
        "FREEZE_SCHEMA": {"type": "integer", "minimum": 0},
        "PUBLICATION_SCHEMA": {"type": "integer", "minimum": 0},
        "ACK_LATE": {"type": "integer", "minimum": 0},
        "GIT_DIRTY": {"type": "integer", "minimum": 0},
        "GIT_HEAD_MISMATCH": {"type": "integer", "minimum": 0},
        "GIT_DIFF_MISMATCH": {"type": "integer", "minimum": 0},
        "HASH_MISMATCH": {"type": "integer", "minimum": 0},
        "PREDICTION_LEDGER": {"type": "integer", "minimum": 0},
        "PROFILE_SCHEMA": {"type": "integer", "minimum": 0},
        "PREDICATE_ASSERTION": {"type": "integer", "minimum": 0},
        "SCORE_ASSERTION": {"type": "integer", "minimum": 0},
        "POLICY_EXCEPTION": {"type": "integer", "minimum": 0},
        "ROW_COUNT": {"type": "integer", "minimum": 0},
        "DUPLICATE_ROW": {"type": "integer", "minimum": 0},
        "OUTPUT_SCHEMA": {"type": "integer", "minimum": 0},
        "FREEZE_STARTED_CREATE": {"type": "integer", "minimum": 0},
        "TARGET_FETCH_STARTED_CREATE": {"type": "integer", "minimum": 0},
        "OPENED_CREATE": {"type": "integer", "minimum": 0},
        "EVALUATION_STARTED_CREATE": {"type": "integer", "minimum": 0},
        "EVALUATION_CRASH": {"type": "integer", "minimum": 0},
        "NUMERIC_STABILITY": {"type": "integer", "minimum": 0},
        "COMPLETED_CREATE": {"type": "integer", "minimum": 0},
        "UNEXPECTED_EXCEPTION": {"type": "integer", "minimum": 0}
      }
    },
    "validSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_status", "materiality_prediction", "contrast_subtype", "contract_sha256", "artifact_schema_sha256", "implementation_commit", "freeze_commit", "acknowledgment_commit", "opened_json_sha256", "evaluation_started_json_sha256", "pulse_raw_sha256", "python_version", "libmpdec_version", "source_hash_check", "minimum_cliff_floor_distance", "row_counts", "selected_probe_global_primary_length", "selected_probe_global_negative_length", "selected_static0_global_primary_length", "selected_mixed8_global_primary_h", "primary_gain", "conditional_regret", "positive_regret_profile_count", "positive_regret_profile_fraction", "positive_regret_stratum_count", "positive_regret_stratum_fraction", "stratum_metrics_40", "action_separation_histogram", "secondary_metrics", "negative_difference_integer", "resource_binding_counts", "failure_counts_by_error_code", "validator_predicates_v01_v24"],
      "properties": {
        "schema_version": {"const": "orf-valid-summary-v3"},
        "protocol_status": {"const": "VALID"},
        "materiality_prediction": {"enum": ["CONFIRMED", "DISCONFIRMED"]},
        "contrast_subtype": {"enum": ["ZERO", "POSITIVE_SUBTHRESHOLD", "MATERIAL"]},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "freeze_commit": {"$ref": "#/$defs/hex40"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "opened_json_sha256": {"$ref": "#/$defs/hex64"},
        "evaluation_started_json_sha256": {"$ref": "#/$defs/hex64"},
        "pulse_raw_sha256": {"$ref": "#/$defs/hex64"},
        "python_version": {"const": "CPython 3.14.3"},
        "libmpdec_version": {"const": "4.0.1"},
        "source_hash_check": {"const": true},
        "minimum_cliff_floor_distance": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?E-[0-9]+$"},
        "row_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["profiles_primary", "profiles_negative", "profiles_all", "candidate_records", "mixtures"],
          "properties": {"profiles_primary": {"const": 5760}, "profiles_negative": {"const": 192}, "profiles_all": {"const": 5952}, "candidate_records": {"type": "integer", "minimum": 0}, "mixtures": {"const": 3003}}
        },
        "selected_probe_global_primary_length": {"enum": [1, 2, 4, 8, 16, 24, 32]},
        "selected_probe_global_negative_length": {"const": 1},
        "selected_static0_global_primary_length": {"enum": [1, 2, 4, 8, 16, 24, 32]},
        "selected_mixed8_global_primary_h": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}], "items": false, "minItems": 7, "maxItems": 7},
        "primary_gain": {"$ref": "#/$defs/rationalMetric"},
        "conditional_regret": {"type": "integer", "minimum": 0},
        "positive_regret_profile_count": {"type": "integer", "minimum": 0, "maximum": 320},
        "positive_regret_profile_fraction": {"$ref": "#/$defs/rationalMetric"},
        "positive_regret_stratum_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "positive_regret_stratum_fraction": {"$ref": "#/$defs/rationalMetric"},
        "stratum_metrics_40": {"type": "array", "items": {"$ref": "#/$defs/stratumMetric"}, "minItems": 40, "maxItems": 40},
        "action_separation_histogram": {
          "type": "array", "minItems": 6, "maxItems": 6, "items": false,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/histogramBin"}, {"properties": {"lower_inclusive": {"const": 0}, "upper_exclusive": {"const": 1}}}]},
            {"allOf": [{"$ref": "#/$defs/histogramBin"}, {"properties": {"lower_inclusive": {"const": 1}, "upper_exclusive": {"const": 100}}}]},
            {"allOf": [{"$ref": "#/$defs/histogramBin"}, {"properties": {"lower_inclusive": {"const": 100}, "upper_exclusive": {"const": 1000}}}]},
            {"allOf": [{"$ref": "#/$defs/histogramBin"}, {"properties": {"lower_inclusive": {"const": 1000}, "upper_exclusive": {"const": 10000}}}]},
            {"allOf": [{"$ref": "#/$defs/histogramBin"}, {"properties": {"lower_inclusive": {"const": 10000}, "upper_exclusive": {"const": 100000}}}]},
            {"allOf": [{"$ref": "#/$defs/histogramBin"}, {"properties": {"lower_inclusive": {"const": 100000}, "upper_exclusive": {"type": "null"}}}]}
          ]
        },
        "secondary_metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["adaptive_over_static", "adaptive_over_mixed8", "signed_oracle0_gap", "probe_generation_cost_share"],
          "properties": {"adaptive_over_static": {"$ref": "#/$defs/rationalMetric"}, "adaptive_over_mixed8": {"$ref": "#/$defs/rationalMetric"}, "signed_oracle0_gap": {"$ref": "#/$defs/rationalMetric"}, "probe_generation_cost_share": {"$ref": "#/$defs/rationalMetric"}}
        },
        "negative_difference_integer": {"const": 0},
        "resource_binding_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["generation", "replay", "candidate", "saturation", "none", "multiway_ties"],
          "properties": {"generation": {"type": "integer", "minimum": 0}, "replay": {"type": "integer", "minimum": 0}, "candidate": {"type": "integer", "minimum": 0}, "saturation": {"type": "integer", "minimum": 0}, "none": {"type": "integer", "minimum": 0}, "multiway_ties": {"type": "integer", "minimum": 0}}
        },
        "failure_counts_by_error_code": {"$ref": "#/$defs/failureCounts"},
        "validator_predicates_v01_v24": {
          "type": "array", "minItems": 24, "maxItems": 24, "items": false,
          "prefixItems": [
            {"const": "V01"}, {"const": "V02"}, {"const": "V03"}, {"const": "V04"},
            {"const": "V05"}, {"const": "V06"}, {"const": "V07"}, {"const": "V08"},
            {"const": "V09"}, {"const": "V10"}, {"const": "V11"}, {"const": "V12"},
            {"const": "V13"}, {"const": "V14"}, {"const": "V15"}, {"const": "V16"},
            {"const": "V17"}, {"const": "V18"}, {"const": "V19"}, {"const": "V20"},
            {"const": "V21"}, {"const": "V22"}, {"const": "V23"}, {"const": "V24"}
          ]
        }
      }
    },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze_started", "freeze_anchor_raw", "freeze", "user_ack", "publication", "target_fetch_started", "revealed_pulse_raw", "opened", "evaluation_started", "profiles", "candidate_records", "mixtures", "valid_summary"],
      "properties": {
        "freeze_started": {"$ref": "#/$defs/nullableHex64"},
        "freeze_anchor_raw": {"$ref": "#/$defs/nullableHex64"},
        "freeze": {"$ref": "#/$defs/nullableHex64"},
        "user_ack": {"$ref": "#/$defs/nullableHex64"},
        "publication": {"$ref": "#/$defs/nullableHex64"},
        "target_fetch_started": {"$ref": "#/$defs/nullableHex64"},
        "revealed_pulse_raw": {"$ref": "#/$defs/nullableHex64"},
        "opened": {"$ref": "#/$defs/nullableHex64"},
        "evaluation_started": {"$ref": "#/$defs/nullableHex64"},
        "profiles": {"$ref": "#/$defs/nullableHex64"},
        "candidate_records": {"$ref": "#/$defs/nullableHex64"},
        "mixtures": {"$ref": "#/$defs/nullableHex64"},
        "valid_summary": {"$ref": "#/$defs/nullableHex64"}
      }
    },
    "partialRows": {
      "type": "object", "additionalProperties": false,
      "required": ["profiles", "candidate_records", "mixtures"],
      "properties": {"profiles": {"type": "integer", "minimum": 0, "maximum": 5952}, "candidate_records": {"type": "integer", "minimum": 0}, "mixtures": {"type": "integer", "minimum": 0, "maximum": 3003}}
    },
    "crashResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_metric_value", "primary_signal", "primary_status", "negative_metric_value", "negative_signal", "negative_status"],
      "properties": {"primary_metric_value": {"const": "NA"}, "primary_signal": {"const": "null"}, "primary_status": {"const": "crash"}, "negative_metric_value": {"const": "NA"}, "negative_signal": {"const": "null"}, "negative_status": {"const": "crash"}}
    },
    "validOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "protocol_status", "last_durable_state", "summary_sha256", "materiality_prediction", "contrast_subtype", "primary_metric_value", "primary_signal", "primary_status", "negative_metric_value", "negative_signal", "negative_status", "available_artifact_hashes", "recorded_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-outcome-v1"}, "protocol_status": {"const": "VALID"}, "last_durable_state": {"const": "EVALUATION_STARTED"},
        "summary_sha256": {"$ref": "#/$defs/hex64"}, "materiality_prediction": {"enum": ["CONFIRMED", "DISCONFIRMED"]}, "contrast_subtype": {"enum": ["ZERO", "POSITIVE_SUBTHRESHOLD", "MATERIAL"]},
        "primary_metric_value": {"$ref": "#/$defs/fixed12"}, "primary_signal": {"enum": ["confirm", "disconfirm"]}, "primary_status": {"enum": ["keep", "discard"]},
        "negative_metric_value": {"const": "0"}, "negative_signal": {"const": "confirm"}, "negative_status": {"const": "keep"},
        "available_artifact_hashes": {"$ref": "#/$defs/artifactHashes"}, "recorded_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "invalidOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "protocol_status", "last_durable_state", "reason_code", "detail", "freeze_json_sha256", "available_artifact_hashes", "partial_row_counts", "ledger_resolution", "recorded_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-outcome-v1"}, "protocol_status": {"const": "PROTOCOL_INVALID"},
        "last_durable_state": {"enum": ["IMPLEMENTED", "FREEZE_FETCH_STARTED", "FROZEN", "ACKNOWLEDGED", "TARGET_FETCH_STARTED", "PULSE_PRESERVED", "OPENED", "EVALUATION_STARTED"]},
        "reason_code": {"enum": ["BEACON_FETCH", "BEACON_SCHEMA", "BEACON_TIMESTAMP", "FREEZE_EXISTS", "FREEZE_SCHEMA", "PUBLICATION_SCHEMA", "ACK_LATE", "GIT_DIRTY", "GIT_HEAD_MISMATCH", "GIT_DIFF_MISMATCH", "HASH_MISMATCH", "PREDICTION_LEDGER", "PROFILE_SCHEMA", "PREDICATE_ASSERTION", "SCORE_ASSERTION", "POLICY_EXCEPTION", "ROW_COUNT", "DUPLICATE_ROW", "OUTPUT_SCHEMA", "FREEZE_STARTED_CREATE", "TARGET_FETCH_STARTED_CREATE", "OPENED_CREATE", "EVALUATION_STARTED_CREATE", "EVALUATION_CRASH", "NUMERIC_STABILITY", "COMPLETED_CREATE", "UNEXPECTED_EXCEPTION"]},
        "detail": {"type": "string", "pattern": "^[ -~]*$"}, "freeze_json_sha256": {"$ref": "#/$defs/nullableHex64"}, "available_artifact_hashes": {"$ref": "#/$defs/artifactHashes"}, "partial_row_counts": {"$ref": "#/$defs/partialRows"}, "ledger_resolution": {"$ref": "#/$defs/crashResolution"}, "recorded_at_utc": {"$ref": "#/$defs/utc"}
