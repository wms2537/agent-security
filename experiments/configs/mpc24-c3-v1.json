  "plugin_semantics": "point_estimate_not_bound",
  "plugin_objective": {
    "eligible_m": "complete>=m and successes_m/m>=0.75 and cumulative_generation_cost_m>0",
    "raw_q_m": "16*successes_m+2 if successes_m>0 else 0",
    "remaining_generation_after_sentinel": "G-c_24_observed",
    "additional_count_n_hat_m": "min(K-1,floor((G-c_24_observed)/c_m),floor((R-rho*c_m)/(rho*c_m)))",
    "portfolio_point_estimate_p_hat_m": "q_m*(1+n_hat_m)",
    "selection": "choose24 iff eligible24 and p_hat_24>=1.10*p_hat_8; otherwise choose longest eligible prefix in [8,1]; if none, state1 and drop sentinel",
    "validity": "one-sentinel plug-in estimate only; no lower bound, upper bound, confidence interval, or future dominance guarantee"
  },
  "post_selection_rule": "verify_every_path_and_fallback_monotonically",
  "fallback_contract": {
    "state_order": [24, 8, 1],
    "current_path": "return the longest currently eligible prefix not exceeding the current state whose inflated observed prefix cost fits the replay ledger and whose slot fits the candidate cap; otherwise drop it",
    "prior_paths": "never rewrite, expand, or convert an already returned path",
    "future_paths": "after a shorter prefix or drop, permanently set state to that shorter prefix, or to 1 after a drop; never move upward",
    "accounting": "charge the full observed attempted-path generation time, the inflated observed returned-prefix replay proxy, and one candidate slot only when a prefix is returned",
    "stop": "stop before the next path when generation margin, replay ledger, sentinel cap, or candidate cap cannot admit any valid return"
  },
  "transfer_assumption": "generation trace success and cumulative prefix time are public replay proxies because replay constructs a fresh environment and reruns the same ordered messages; model sampling, reset overhead, guardrail state, and latency may differ, so every public replay can invalidate the estimate",
