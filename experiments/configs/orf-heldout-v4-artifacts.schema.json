{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invalid.example/orf-heldout-v4-artifacts.schema.json",
  "title": "ORF held-out v4 strict artifact schemas",
  "oneOf": [
    {"$ref": "#/$defs/freeze"},
    {"$ref": "#/$defs/publication"},
    {"$ref": "#/$defs/opened"},
    {"$ref": "#/$defs/evaluationStarted"},
    {"$ref": "#/$defs/abandoned"},
    {"$ref": "#/$defs/summary"},
    {"$ref": "#/$defs/nistPulseEnvelope"}
  ],
  "$defs": {
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex128Upper": {"type": "string", "pattern": "^[0-9A-F]{128}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comp/sdk/aicomp_sdk/scoring.py", "comp/sdk/aicomp_sdk/core/predicates.py", "comp/sdk/aicomp_sdk/evaluation/ops.py", "comp/sdk/kaggle_evaluation/jed_attack_134815/jed_attack_gateway.py", "experiments/attack.py"],
      "properties": {
        "comp/sdk/aicomp_sdk/scoring.py": {"$ref": "#/$defs/hex64"},
        "comp/sdk/aicomp_sdk/core/predicates.py": {"$ref": "#/$defs/hex64"},
        "comp/sdk/aicomp_sdk/evaluation/ops.py": {"$ref": "#/$defs/hex64"},
        "comp/sdk/kaggle_evaluation/jed_attack_134815/jed_attack_gateway.py": {"$ref": "#/$defs/hex64"},
        "experiments/attack.py": {"$ref": "#/$defs/hex64"}
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_sha256", "artifact_schema_sha256", "implementation_commit", "evaluator_sha256", "prediction_ledger_path", "prediction_ledger_sha256", "source_hashes_sha256", "anchor_raw_sha256", "anchor_uri", "anchor_timestamp_iso", "anchor_unix_ms", "target_unix_ms", "created_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-freeze-v2"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "evaluator_sha256": {"$ref": "#/$defs/hex64"},
        "prediction_ledger_path": {"const": "results.tsv"},
        "prediction_ledger_sha256": {"$ref": "#/$defs/hex64"},
        "source_hashes_sha256": {"$ref": "#/$defs/sourceHashes"},
        "anchor_raw_sha256": {"$ref": "#/$defs/hex64"},
        "anchor_uri": {"type": "string", "pattern": "^https://beacon\\.nist\\.gov/"},
        "anchor_timestamp_iso": {"$ref": "#/$defs/utc"},
        "anchor_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "created_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "freeze_commit", "freeze_json_sha256", "target_unix_ms", "publication_message", "user_acknowledgment", "ack_received_at_utc", "user_ack_file_sha256"],
      "properties": {
        "schema_version": {"const": "orf-publication-v2"},
        "freeze_commit": {"$ref": "#/$defs/hex40"},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "publication_message": {"type": "string", "pattern": "^ORF-B FREEZE FREEZE_COMMIT=[0-9a-f]{40} FREEZE_JSON_SHA256=[0-9a-f]{64} TARGET_UNIX_MS=[0-9]+$"},
        "user_acknowledgment": {"type": "string", "pattern": "^ACK ORF-B FREEZE FREEZE_COMMIT=[0-9a-f]{40} FREEZE_JSON_SHA256=[0-9a-f]{64} TARGET_UNIX_MS=[0-9]+$"},
        "ack_received_at_utc": {"$ref": "#/$defs/utc"},
        "user_ack_file_sha256": {"$ref": "#/$defs/hex64"}
      }
    },
    "opened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_sha256", "artifact_schema_sha256", "implementation_commit", "freeze_commit", "acknowledgment_commit", "freeze_json_sha256", "publication_json_sha256", "target_unix_ms", "pulse_raw_sha256", "pulse_uri", "pulse_timestamp_iso", "pulse_unix_ms", "pulse_output_value", "master_digest_hex", "opened_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-opened-v2"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "freeze_commit": {"$ref": "#/$defs/hex40"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "publication_json_sha256": {"$ref": "#/$defs/hex64"},
        "target_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "pulse_raw_sha256": {"$ref": "#/$defs/hex64"},
        "pulse_uri": {"type": "string", "pattern": "^https://beacon\\.nist\\.gov/"},
        "pulse_timestamp_iso": {"$ref": "#/$defs/utc"},
        "pulse_unix_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "pulse_output_value": {"$ref": "#/$defs/hex128Upper"},
        "master_digest_hex": {"$ref": "#/$defs/hex64"},
        "opened_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "evaluationStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_sha256", "opened_json_sha256", "acknowledgment_commit", "started_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-evaluation-started-v2"},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "opened_json_sha256": {"$ref": "#/$defs/hex64"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "started_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "abandoned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "last_completed_state", "freeze_json_sha256", "reason_code", "detail", "abandoned_at_utc"],
      "properties": {
        "schema_version": {"const": "orf-abandoned-v2"},
        "last_completed_state": {"enum": ["FROZEN", "ACKNOWLEDGED", "PULSE_PRESERVED", "OPENED", "EVALUATION_STARTED"]},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "reason_code": {"enum": ["ACK_LATE", "BEACON_FETCH", "BEACON_SCHEMA", "BEACON_TIMESTAMP", "GIT_DIRTY", "GIT_HEAD_MISMATCH", "GIT_DIFF_MISMATCH", "HASH_MISMATCH", "PUBLICATION_SCHEMA", "OPENED_CREATE", "EVALUATION_STARTED_CREATE", "EVALUATION_CRASH"]},
        "detail": {"type": "string", "pattern": "^[ -~]*$"},
        "abandoned_at_utc": {"$ref": "#/$defs/utc"}
      }
    },
    "rationalMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "percent_fixed_12"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1},
        "percent_fixed_12": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{12}$"}
      }
    },
    "stratumMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum_index", "adaptive_objective", "global_objective", "regret", "positive_regret_profiles", "gain"],
      "properties": {
        "stratum_index": {"type": "integer", "minimum": 0, "maximum": 39},
        "adaptive_objective": {"type": "integer", "minimum": 0},
        "global_objective": {"type": "integer", "minimum": 0},
        "regret": {"type": "integer", "minimum": 0},
        "positive_regret_profiles": {"type": "integer", "minimum": 0, "maximum": 8},
        "gain": {"$ref": "#/$defs/rationalMetric"}
      }
    },
    "histogramBin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_inclusive", "upper_exclusive", "count"],
      "properties": {
        "lower_inclusive": {"type": "integer", "minimum": 0},
        "upper_exclusive": {"type": ["integer", "null"], "minimum": 1},
        "count": {"type": "integer", "minimum": 0, "maximum": 320}
      }
    },
    "secondaryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptive_over_static", "adaptive_over_mixed8", "signed_oracle0_gap", "probe_cost_share"],
      "properties": {
        "adaptive_over_static": {"$ref": "#/$defs/rationalMetric"},
        "adaptive_over_mixed8": {"$ref": "#/$defs/rationalMetric"},
        "signed_oracle0_gap": {"$ref": "#/$defs/rationalMetric"},
        "probe_cost_share": {"$ref": "#/$defs/rationalMetric"}
      }
    },
    "rowCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles_primary", "profiles_negative", "profiles_all", "mixture_profiles", "mixtures", "candidate_records"],
      "properties": {
        "profiles_primary": {"const": 5760},
        "profiles_negative": {"const": 192},
        "profiles_all": {"const": 5952},
        "mixture_profiles": {"const": 960960},
        "mixtures": {"const": 3003},
        "candidate_records": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_status", "materiality_prediction", "contrast_subtype", "contract_sha256", "artifact_schema_sha256", "implementation_commit", "freeze_commit", "acknowledgment_commit", "freeze_json_sha256", "publication_json_sha256", "opened_json_sha256", "evaluation_started_json_sha256", "pulse_raw_sha256", "python_version", "source_hash_check", "row_counts", "selected_probe_global_primary_length", "selected_probe_global_negative_length", "selected_static0_global_primary_length", "selected_mixed8_global_primary_h", "primary_gain", "conditional_regret", "positive_regret_profile_count", "positive_regret_profile_fraction", "positive_regret_stratum_count", "positive_regret_stratum_fraction", "stratum_metrics_40", "action_separation_histogram", "secondary_metrics", "negative_difference_integer", "resource_binding_counts", "failure_counts_by_error_code"],
      "properties": {
        "schema_version": {"const": "orf-summary-v2"},
        "protocol_status": {"enum": ["VALID", "PROTOCOL_INVALID"]},
        "materiality_prediction": {"enum": ["CONFIRMED", "DISCONFIRMED", "NOT_EVALUABLE"]},
        "contrast_subtype": {"enum": ["ZERO", "POSITIVE_SUBTHRESHOLD", "MATERIAL", "NOT_EVALUABLE"]},
        "contract_sha256": {"$ref": "#/$defs/hex64"},
        "artifact_schema_sha256": {"$ref": "#/$defs/hex64"},
        "implementation_commit": {"$ref": "#/$defs/hex40"},
        "freeze_commit": {"$ref": "#/$defs/hex40"},
        "acknowledgment_commit": {"$ref": "#/$defs/hex40"},
        "freeze_json_sha256": {"$ref": "#/$defs/hex64"},
        "publication_json_sha256": {"$ref": "#/$defs/hex64"},
        "opened_json_sha256": {"$ref": "#/$defs/hex64"},
        "evaluation_started_json_sha256": {"$ref": "#/$defs/hex64"},
        "pulse_raw_sha256": {"$ref": "#/$defs/hex64"},
        "python_version": {"const": "CPython 3.14.3"},
        "source_hash_check": {"const": true},
        "row_counts": {"$ref": "#/$defs/rowCounts"},
        "selected_probe_global_primary_length": {"enum": [1, 2, 4, 8, 16, 24, 32]},
        "selected_probe_global_negative_length": {"const": 1},
        "selected_static0_global_primary_length": {"enum": [1, 2, 4, 8, 16, 24, 32]},
        "selected_mixed8_global_primary_h": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}, {"type": "integer", "minimum": 0, "maximum": 8}], "items": false, "minItems": 7, "maxItems": 7},
        "primary_gain": {"$ref": "#/$defs/rationalMetric"},
        "conditional_regret": {"type": "integer", "minimum": 0},
        "positive_regret_profile_count": {"type": "integer", "minimum": 0, "maximum": 320},
        "positive_regret_profile_fraction": {"$ref": "#/$defs/rationalMetric"},
        "positive_regret_stratum_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "positive_regret_stratum_fraction": {"$ref": "#/$defs/rationalMetric"},
        "stratum_metrics_40": {"type": "array", "items": {"$ref": "#/$defs/stratumMetric"}, "minItems": 40, "maxItems": 40},
        "action_separation_histogram": {"type": "array", "items": {"$ref": "#/$defs/histogramBin"}, "minItems": 6, "maxItems": 6},
        "secondary_metrics": {"$ref": "#/$defs/secondaryMetrics"},
        "negative_difference_integer": {"const": 0},
        "resource_binding_counts": {"type": "object", "additionalProperties": false, "required": ["generation", "replay", "candidate", "saturation", "none"], "properties": {"generation": {"type": "integer", "minimum": 0}, "replay": {"type": "integer", "minimum": 0}, "candidate": {"type": "integer", "minimum": 0}, "saturation": {"type": "integer", "minimum": 0}, "none": {"type": "integer", "minimum": 0}}},
        "failure_counts_by_error_code": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "propertyNames": {"enum": ["NONE", "BEACON_FETCH", "BEACON_SCHEMA", "BEACON_TIMESTAMP", "FREEZE_EXISTS", "FREEZE_SCHEMA", "PUBLICATION_SCHEMA", "ACK_LATE", "GIT_DIRTY", "GIT_HEAD_MISMATCH", "GIT_DIFF_MISMATCH", "HASH_MISMATCH", "PREDICTION_LEDGER", "PROFILE_SCHEMA", "PREDICATE_ASSERTION", "SCORE_ASSERTION", "POLICY_EXCEPTION", "ROW_COUNT", "DUPLICATE_ROW", "OUTPUT_SCHEMA", "OPENED_CREATE", "EVALUATION_STARTED_CREATE", "EVALUATION_CRASH", "UNEXPECTED_EXCEPTION"]}}
      }
    },
    "nistPulseEnvelope": {
      "type": "object",
      "required": ["pulse"],
      "properties": {
        "pulse": {
          "type": "object",
          "required": ["uri", "version", "period", "timeStamp", "statusCode", "outputValue"],
          "properties": {
            "uri": {"type": "string", "pattern": "^https://beacon\\.nist\\.gov/"},
            "version": {"const": "2.0"},
            "period": {"const": 60000},
            "timeStamp": {"$ref": "#/$defs/utc"},
            "statusCode": {"const": 0},
            "outputValue": {"$ref": "#/$defs/hex128Upper"}
          }
        }
      }
    }
  }
}
